# Copy to .env in the directory where you start chat. Process settings win.
# Never put a real API key in this template.
OPENAI_API_KEY=
# Select a Responses API model with function calling.
OPENAI_MODEL=

# Reserved settings. Use --db for the database path. Reporting uses Asia/Singapore.
UNIFIED_FITNESS_DB=data/unified-fitness.sqlite3
UNIFIED_FITNESS_TIMEZONE=Asia/Singapore
